+} from '../multi-engine'
+import { startProxy } from '../proxy'
+
+function upstreamApp() {
+  return Bun.serve({
+    hostname: '127.0.0.1',
+    port: 0,
+    fetch: (request) => {
+      const url = new URL(request.url)
+      if (url.pathname === '/') {
+        return new Response('<html><head><title>Freebuff Desktop</title></head><body>hi</body></html>', {
+          headers: { 'content-type': 'text/html' },
+        })
+      }
+      if (url.pathname === '/api/echo-header') {
+        return Response.json({
+          launch: request.headers.get('x-freebuff-launch-id'),
+        })
+      }
+      return new Response('not found', { status: 404 })
+    },
+  })
+}
+
+describe('multi-engine reconcile', () => {
+  it('injects the launch id and stamps the version badge', async () => {
+    const upstream = upstreamApp()
+    const upstreamPort = upstream.port
+    if (!upstreamPort) throw new Error('fake engine did not bind')
+    const entry: EngineEntry = {
+      accountId: 'acc-1',
+      port: upstreamPort,
+      launchId: 'launch-secret-1',
+      version: '9.9.9',
+      label: 'owner@example.com',
+    }
+    const engines = new Map()
+    const id = proxyIdFor('acc-1')
+    expect(id).toBe('freebuff.proxy[acc-1]')
+    const registered: Array<{ id: string; record: Record<string, unknown> }> = []
+    await reconcileEngines(new Map([['acc-1', entry]]), engines, {
+      registryPath: '/nonexistent/registry.json',
+      hostname: '127.0.0.1',
+      basePort: 45660,
+      auth: null as MultiEngineAuth,
