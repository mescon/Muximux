diff -ruN rev/freebuff/server/src/multi-engine.ts live2/freebuff/server/src/multi-engine.ts
--- a/freebuff/server/src/multi-engine.ts	1970-01-01 08:00:00.000000000 +0800
+++ b/freebuff/server/src/multi-engine.ts	2026-11-14 19:10:56.136050840 +0700
@@ -0,0 +1,385 @@
+/**
+ * Multi-engine front for daemon-spawned Freebuff Desktop engines (M-322).
+ *
+ * The daemon publishes one entry per connected account to
+ * `<profiles-root>/registry.json` (0600, atomic rename):
+ * `{accountId, runtimeId, label, version, port, pid, launchId}`.
+ * For each entry this module opens a loopback listener that injects
+ * `x-freebuff-launch-id` on every upstream HTTP and WebSocket request and
+ * stamps the version badge into document responses — the same proxy the
+ * single-engine server uses, with the password gate kept in front.
+ *
+ * Stable per-account ports come from the app port registry
+ * (`ports alloc freebuff none proxy`), heartbeat-kept with a TTL; the
+ * registry file names the account, the ports registry names the listener.
+ * Registry down never blocks start; a stopped engine loses its listener and
+ * its registration.
+ */
+import {
+  existsSync,
+  readFileSync,
+  statSync,
+  watch,
+  type FSWatcher,
+} from 'node:fs'
+import path from 'node:path'
+
+import { startProxy, type ProxyAuth, type ProxyHandle, type ProxyTls } from './proxy'
+
+export type EngineEntry = {
+  accountId: string
+  runtimeId?: string
+  label?: string
+  version?: string
+  port: number
+  pid?: number
+  launchId: string
+}
+
+export type EnginePorts = {
+  remove: (id: string) => Promise<void>
+  register: (
+    id: string,
+    record: Record<string, unknown>,
+  ) => Promise<void>
+  /** Refresh last_seen so the registry (TTL) does not reap a live listener. */
+  heartbeat: (id: string) => Promise<void>
+}
+
+export type MultiEngineAuth = ProxyAuth
+export type MultiEngineTls = ProxyTls
+
+export type MultiEngineOptions = {
+  registryPath: string
+  hostname: string
+  basePort: number
+  auth: MultiEngineAuth
+  secureCookie: boolean
+  tls?: MultiEngineTls
+  ports: EnginePorts | null
+  onEvent?: (message: string) => void
+}
+
+export type MultiEngineHandle = {
+  engines: Map<string, { entry: EngineEntry; proxy: ProxyHandle }>
+  stop: () => Promise<void>
+}
+
+function validEntry(raw: unknown): EngineEntry | null {
+  if (!raw || typeof raw !== 'object') return null
+  const e = raw as Record<string, unknown>
+  const accountId = typeof e.accountId === 'string' ? e.accountId.trim() : ''
+  const port = typeof e.port === 'number' ? e.port : Number.NaN
+  const launchId = typeof e.launchId === 'string' ? e.launchId : ''
+  if (!accountId || !Number.isInteger(port) || port < 1 || port > 65535)
+    return null
+  if (!launchId) return null
+  const version = typeof e.version === 'string' ? e.version : ''
+  const label = typeof e.label === 'string' ? e.label : ''
+  const pid = typeof e.pid === 'number' ? e.pid : undefined
+  return { accountId, port, launchId, version, label, pid }
+}
+
+function readEntries(registryPath: string): Map<string, EngineEntry> {
+  const out = new Map<string, EngineEntry>()
+  let raw: string
+  try {
+    raw = readFileSync(registryPath, 'utf8')
+  } catch {
+    return out
+  }
+  try {
+    const parsed: unknown = JSON.parse(raw)
+    const list = Array.isArray(parsed) ? parsed : []
+    for (const item of list) {
+      const entry = validEntry(item)
+      if (entry) out.set(entry.accountId, entry)
+    }
+  } catch {
+    // A torn read resolves on the next watch event; atomic renames make
+    // partial JSON rare and self-healing.
+  }
+  return out
+}
+
+/**
+ * Display version for an engine (M-322 follow-up): prefer the daemon
+ * registry's `version` (written by daemons with PR #193), else read
+ * FREEBUFF_APP_VERSION from the engine process environment via /proc
+ * (same-user read; the version is not secret), else 'unknown'.
+ * The cmdline guard avoids trusting a reused pid. Never throws.
+ */
+export function parseAppVersion(environText: string): string | null {
+  for (const kv of environText.split('\0')) {
+    if (kv.startsWith('FREEBUFF_APP_VERSION=')) {
+      const v = kv.slice('FREEBUFF_APP_VERSION='.length).trim()
+      if (v) return v
+    }
+  }
+  return null
+}
+
+function engineCmdlineOk(pid: number): boolean {
+  try {
+    return readFileSync(`/proc/${pid}/cmdline`, 'utf8').includes('orchestrator')
+  } catch {
+    return false
+  }
+}
+
+export function displayVersion(entry: EngineEntry): string {
+  const fromRegistry = entry.version?.trim()
+  if (fromRegistry) return fromRegistry
+  if (
+    entry.pid &&
+    Number.isInteger(entry.pid) &&
+    entry.pid > 0 &&
+    engineCmdlineOk(entry.pid)
+  ) {
+    try {
+      const found = parseAppVersion(
+        readFileSync(`/proc/${entry.pid}/environ`, 'utf8'),
+      )
+      if (found) return found
+    } catch {
+      // Environ unreadable; fall through to 'unknown'.
+    }
+  }
+  return 'unknown'
+}
+
+const MONTHS = [
+  'JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN',
+  'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC',
+]
+
+/** Format an epoch-ms timestamp as YYMMMDD.HHMM in server-local time. */
+export function formatProcStart(mtimeMs: number): string {
+  const d = new Date(mtimeMs)
+  const yy = String(d.getFullYear() % 100).padStart(2, '0')
+  const mmm = MONTHS[d.getMonth()]
+  const dd = String(d.getDate()).padStart(2, '0')
+  const hh = String(d.getHours()).padStart(2, '0')
+  const mi = String(d.getMinutes()).padStart(2, '0')
+  return `${yy}${mmm}${dd}.${hh}${mi}`
+}
+
+/**
+ * Engine start tag from /proc (same-user read, orchestrator-guard so a
+ * reused pid can't spoof it). Null when unknown — never throws.
+ */
+export function procStartTag(pid: number | undefined): string | null {
+  if (!pid || !Number.isInteger(pid) || pid <= 0 || !engineCmdlineOk(pid)) {
+    return null
+  }
+  try {
+    return formatProcStart(statSync(`/proc/${pid}`).mtimeMs)
+  } catch {
+    return null
+  }
+}
+
+/**
+ * Compact badge version: `<semver>-<YYMMMDD.HHMM>` from the engine's start
+ * time, plain `<semver>` when the start time is unknown (e.g. no pid yet).
+ */
+export function versionTag(entry: EngineEntry): string {
+  const v = displayVersion(entry)
+  const t = procStartTag(entry.pid)
+  return t ? `${v}-${t}` : v
+}
+
+export function proxyIdFor(accountId: string): string {
+  return `freebuff.proxy[${accountId}]`
+}
+
+function currentPorts(
+  current: Map<string, { entry: EngineEntry; proxy: ProxyHandle }>,
+): Set<number> {
+  const used = new Set<number>()
+  for (const state of current.values()) used.add(state.proxy.port)
+  return used
+}
+
+async function portFree(port: number): Promise<boolean> {
+  try {
+    const probe = Bun.serve({ port, hostname: '127.0.0.1', fetch: () => new Response('ok') })
+    await probe.stop(true)
+    return true
+  } catch {
+    return false
+  }
+}
+
+async function pickPort(base: number, used: Set<number>): Promise<number> {
+  for (let port = base; port < base + 100; port += 1) {
+    if (used.has(port)) continue
+    if (await portFree(port)) return port
+  }
+  throw new Error(`no free listener port near ${base}`)
+}
+export async function reconcileEngines(
+  wanted: Map<string, EngineEntry>,
+  current: Map<string, { entry: EngineEntry; proxy: ProxyHandle }>,
+  options: MultiEngineOptions,
+): Promise<void> {
+  const log = options.onEvent ?? ((): void => {})
+  for (const [accountId, state] of current) {
+    const next = wanted.get(accountId)
+    if (
+      next &&
+      next.port === state.entry.port &&
+      next.launchId === state.entry.launchId &&
+      (next.version ?? '') === (state.entry.version ?? '')
+    ) {
+      continue
+    }
+    try {
+      await state.proxy.stop()
+    } catch (error) {
+      log(`[multi-engine] stop ${accountId} failed: ${String(error)}`)
+    }
+    current.delete(accountId)
+    if (options.ports) {
+      try {
+        await options.ports.remove(proxyIdFor(accountId))
+      } catch (error) {
+        log(`[multi-engine] unregister ${accountId} failed: ${String(error)}`)
+      }
+    }
+  }
+  for (const [accountId, entry] of wanted) {
+    const state = current.get(accountId)
+    if (
+      state &&
+      state.entry.port === entry.port &&
+      state.entry.launchId === entry.launchId &&
+      (state.entry.version ?? '') === (entry.version ?? '')
+    ) {
+      continue
+    }
+    if (state) {
+      try {
+        await state.proxy.stop()
+      } catch (error) {
+        log(`[multi-engine] restart stop ${accountId} failed: ${String(error)}`)
+      }
+      current.delete(accountId)
+    }
+    const listenPort = await pickPort(options.basePort, currentPorts(current))
+    const proxy = startProxy({
+      hostname: options.hostname,
+      port: listenPort,
+      orchestratorPort: entry.port,
+      auth: options.auth,
+      secureCookie: options.secureCookie,
+      tls: options.tls,
+      launchId: entry.launchId,
+      versionLabel: versionTag(entry),
+      accountLabel: entry.label || accountId,
+    })
+    current.set(accountId, { entry, proxy })
+    if (options.ports) {
+      try {
+        await options.ports.register(proxyIdFor(accountId), {
+          id: proxyIdFor(accountId),
+          app: 'freebuff',
+          lane: 'none',
+          role: 'proxy',
+          port: proxy.port,
+          pid: entry.pid ?? null,
+          ttl: 60,
+          portal: {
+            title: `Freebuff Desktop ${versionTag(entry)} · ${entry.label || accountId}`,
+            tab: true,
+          },
+        })
+      } catch (error) {
+        log(`[multi-engine] register ${accountId} failed: ${String(error)}`)
+      }
+    }
+    log(
+      `[multi-engine] ${accountId} (engine :${entry.port}) -> :${proxy.port}`,
+    )
+  }
+}
+
+export function startMultiEngine(
+  options: MultiEngineOptions,
+): MultiEngineHandle {
+  const engines = new Map<string, { entry: EngineEntry; proxy: ProxyHandle }>()
+  const log = options.onEvent ?? ((): void => {})
+
+  const sync = (): void => {
+    void reconcileEngines(readEntries(options.registryPath), engines, options)
+      .catch((error: unknown) => {
+        log(`[multi-engine] reconcile failed: ${String(error)}`)
+      })
+  }
+
+  sync()
+  // Heartbeat below the 60s registry TTL so live listeners are never reaped.
+  const beat = setInterval(() => {
+    if (!options.ports) return
+    for (const accountId of engines.keys()) {
+      void options.ports
+        .heartbeat(proxyIdFor(accountId))
+        .catch((error: unknown) => {
+          log(`[multi-engine] heartbeat ${accountId} failed: ${String(error)}`)
+        })
+    }
+  }, 25_000)
+  beat.unref?.()
+  let watcher: FSWatcher | null = null
+  try {
+    const dir = path.dirname(options.registryPath)
+    if (existsSync(dir)) {
+      watcher = watch(dir, (_event, filename) => {
+        if (
+          typeof filename === 'string' &&
+          filename !== path.basename(options.registryPath)
+        ) {
+          return
+        }
+        sync()
+      })
+      watcher.on('error', () => {
+        watcher = null
+      })
+    }
+  } catch {
+    watcher = null
+  }
+  // The daemon rewrites the file on every connect/disconnect; poll as a
+  // backstop for watchers lost to renames or network filesystems.
+  const poll = setInterval(sync, 15_000)
+  poll.unref?.()
+
+  return {
+    engines,
+    stop: async () => {
+      clearInterval(poll)
+      clearInterval(beat)
+      try {
+        watcher?.close()
+      } catch {
+        // Already closed.
+      }
+      for (const [accountId, state] of engines) {
+        try {
+          await state.proxy.stop()
+        } catch {
+          // Best-effort shutdown.
+        }
+        if (options.ports) {
+          try {
+            await options.ports.remove(proxyIdFor(accountId))
+          } catch {
+            // Best-effort shutdown.
+          }
+        }
+      }
+      engines.clear()
+    },
+  }
+}
